generator client {
  provider      = "prisma-client-js"
  output        = "../src/common/prisma/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Articles_demo {
  id        Int       @id @default(autoincrement())
  content   String?   @db.VarChar(255)
  isDeleted Int?      @default(0) @db.SmallInt
  deletedAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @db.Timestamp(6)
}

model admins {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  fullName  String    @db.VarChar(255)
  deletedBy Int       @default(0)
  isDeleted Int       @default(0) @db.SmallInt
  deletedAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @db.Timestamp(6)
}

model categories {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  deletedBy Int        @default(0)
  isDeleted Int        @default(0) @db.SmallInt
  deletedAt DateTime?  @db.Timestamp(6)
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @db.Timestamp(6)
  products  products[]
}

model messages {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(255)
  fullName  String?   @db.VarChar(255)
  phone     String?   @db.VarChar(15)
  subject   String?   @db.VarChar(255)
  message   String?
  deletedBy Int       @default(0)
  isDeleted Int       @default(0) @db.SmallInt
  deletedAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @db.Timestamp(6)
}

model order {
  id            Int             @id @default(autoincrement())
  firstName     String          @db.VarChar(255)
  lastName      String          @db.VarChar(255)
  email         String          @db.VarChar(255)
  phone         String          @db.VarChar(15)
  city          String          @db.VarChar(255)
  ward          String          @db.VarChar(255)
  address       String          @db.VarChar(255)
  note          String?
  deletedBy     Int             @default(0)
  isDeleted     Int             @default(0) @db.SmallInt
  deletedAt     DateTime?       @db.Timestamp(6)
  createdAt     DateTime        @default(now()) @db.Timestamp(6)
  updatedAt     DateTime        @default(now()) @db.Timestamp(6)
  paid_products paid_products[]
}

model paid_products {
  id                  Int                @id @default(autoincrement())
  order_id            Int
  product_quantity_id Int
  amount              Int
  deletedBy           Int                @default(0)
  isDeleted           Int                @default(0) @db.SmallInt
  deletedAt           DateTime?          @db.Timestamp(6)
  createdAt           DateTime           @default(now()) @db.Timestamp(6)
  updatedAt           DateTime           @default(now()) @db.Timestamp(6)
  order               order              @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_quantities  product_quantities @relation(fields: [product_quantity_id], references: [id], onDelete: Cascade)

  @@index([order_id], map: "idx_paid_products_order_id")
  @@index([product_quantity_id], map: "idx_paid_products_product_quantity_id")
}

model product_quantities {
  id            Int             @id @default(autoincrement())
  product_id    Int
  quantity_id   Int
  price         Decimal         @db.Decimal(15, 2)
  deletedBy     Int             @default(0)
  isDeleted     Int             @default(0) @db.SmallInt
  deletedAt     DateTime?       @db.Timestamp(6)
  createdAt     DateTime        @default(now()) @db.Timestamp(6)
  updatedAt     DateTime        @default(now()) @db.Timestamp(6)
  paid_products paid_products[]
  products      products        @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "product_quantities_ibfk_1")
  quantities    quantities      @relation(fields: [quantity_id], references: [id], map: "product_quantities_ibfk_2")

  @@unique([product_id, quantity_id])
  @@index([quantity_id], map: "idx_product_quantities_quantity_id")
}

model products {
  id                   Int                  @id @default(autoincrement())
  category_id          Int
  name                 String               @db.VarChar(255)
  short_description    String?
  detailed_description String?
  image_link           String?
  deletedBy            Int                  @default(0)
  isDeleted            Int                  @default(0) @db.SmallInt
  deletedAt            DateTime?            @db.Timestamp(6)
  createdAt            DateTime             @default(now()) @db.Timestamp(6)
  updatedAt            DateTime             @default(now()) @db.Timestamp(6)
  product_quantities   product_quantities[]
  categories           categories           @relation(fields: [category_id], references: [id], map: "products_ibfk_1")

  @@index([category_id], map: "idx_products_category_id")
}

model quantities {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(255)
  deletedBy          Int                  @default(0)
  isDeleted          Int                  @default(0) @db.SmallInt
  deletedAt          DateTime?            @db.Timestamp(6)
  createdAt          DateTime             @default(now()) @db.Timestamp(6)
  updatedAt          DateTime             @default(now()) @db.Timestamp(6)
  product_quantities product_quantities[]
}
